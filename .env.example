# TruthOracle contracts — operator scripts configuration.
# Copy to `.env` and fill in the blanks. Every script loads `<repo>/.env` via dotenv and
# reads ONLY the names below (the VITE_ spellings are kept so a `.env` copied from the
# frontend keeps working). Nothing here is ever shipped to a browser. Optional variables are
# active entries left blank, never commented out: blank means "use the fallback" everywhere.
#
# Which script reads what (the network is chosen with `--network devnet|zkpc`, never from .env):
#   dars:upload        ZKPC_* (default target) or VITE_CANTON_PARTICIPANT_URL + VITE_KEYCLOAK_URL/REALM + KEYCLOAK_CLIENT_ID/SECRET
#   ledger:query       same, plus VITE_TRUTHORACLE_PACKAGE_NAME, VITE_ENTERPRISE_WALLET_PARTY_ID
#   contracts:active   same, plus VITE_TRUTHORACLE_PACKAGE_NAME, VITE_ENTERPRISE_WALLET_PARTY_ID (or --party)
#   rights:grant       same, plus VITE_ENTERPRISE_WALLET_PARTY_ID (or --party)
#   create:contract    VITE_ENTERPRISE_WALLET_URL, WALLET_KEYCLOAK_* → KEYCLOAK_* → VITE_KEYCLOAK_*,
#                      VITE_TRUTHORACLE_PACKAGE_ID, VITE_ENTERPRISE_WALLET_PARTY_ID, VITE_ENTERPRISE_WALLET_APP_NAME
#                      (user-wallet: COLLATERAL_INSTRUMENT_ADMIN, COLLATERAL_INSTRUMENT_ID)
#   create:market      VITE_TRUTHORACLE_PACKAGE_ID/_NAME, VITE_ENTERPRISE_WALLET_PARTY_ID/_URL/_APP_NAME,
#                      KEYCLOAK_* (→ VITE_KEYCLOAK_* for URL/realm), VITE_CANTON_PARTICIPANT_URL,
#                      COLLATERAL_INSTRUMENT_ADMIN, COLLATERAL_INSTRUMENT_ID (--collateral-admin / --collateral-id override),
#                      AUDIT_OBSERVER_PARTIES (--audit-observers adds to it)
#   create:account     VITE_ENTERPRISE_WALLET_URL, WALLET_KEYCLOAK_* → KEYCLOAK_* → VITE_KEYCLOAK_*,
#                      WALLET_VALIDATOR_NAME, WALLET_VALIDATOR_ID
#
# Credentials (CLIENT_ID / CLIENT_SECRET) are deliberately NOT read from any VITE_-prefixed
# name — see scripts/create-contract.ts.

# -----------------------------------------------------------------------------
# Package
# -----------------------------------------------------------------------------
# Package id of the DAR currently deployed and the daml.yaml `name:`. The id is printed by the
# build — `npm run dars:build`, then `dpm inspect-dar daml/.daml/dist/truthoracle-v17-1.0.0.dar --json | jq -r .main_package_id`
# (daml/DEPLOYMENT.md records the one deployed) — and changes with every source or SDK change.
# Active-contracts filters must use the package NAME ("#name:Module:Entity"); left blank, the
# query scripts (ledger:query, contracts:active) use the `name:` of daml/daml.yaml, i.e. the
# package this checkout builds. Set it to query an older lineage still on the participant.
VITE_TRUTHORACLE_PACKAGE_ID=
VITE_TRUTHORACLE_PACKAGE_NAME=truthoracle-v17

# -----------------------------------------------------------------------------
# Collateral instrument (CIP-56 / Canton token standard) — the denomination of every market
# create:market creates and of every wallet create:contract user-wallet creates. A market's
# collateral is fixed at creation; wallets are one per (owner, instrument).
# Target: cBYN, the Canton Belarusian Ruble (pegged 1:1 to BYN) — admin = Cantor8's transfer-agent
# party, id = cBYN — once Cantor8 deploys it on DevNet (truthoracle-backend docs/TOKENS.md §9).
# DevNet stand-in until then: Canton Coin, the only token-standard instrument on DevNet today —
# admin = the DSO party, id = Amulet. Switching is this pair plus new markets; nothing migrates.
# -----------------------------------------------------------------------------
COLLATERAL_INSTRUMENT_ADMIN=DSO::1220be58c29e65de40bf273be1dc2b266d43a9a002ea5b18955aeef7aac881bb471a
COLLATERAL_INSTRUMENT_ID=Amulet

# -----------------------------------------------------------------------------
# Compliance observers — the regulator's party ids, comma separated. create:market puts them on
# every market it creates as `auditObservers` (the market copies them onto the bond and model-prize
# PendingPayouts it later queues), the same list the backend passes as AUDIT_OBSERVER_PARTIES on
# everything it signs (truthoracle-backend docs/TOKENS.md §2.4). Blank = no regulator sees the
# markets this script creates (it says so before submitting). `--audit-observers` adds parties for
# one run and never drops the ones configured here — the backend's POST /admin/markets rule.
# -----------------------------------------------------------------------------
AUDIT_OBSERVER_PARTIES=

# -----------------------------------------------------------------------------
# DevNet (digik) — Canton JSON Ledger API + Keycloak
# -----------------------------------------------------------------------------
VITE_CANTON_PARTICIPANT_URL=https://api.validator.dev.digik.cantor8.tech/api/ledger
VITE_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
VITE_KEYCLOAK_REALM=master
# client_credentials pair for the DevNet Keycloak above (shared by Cantor8).
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Non-VITE aliases for the issuer: create:contract, create:market and create:account read these
# first and fall back to VITE_KEYCLOAK_URL / VITE_KEYCLOAK_REALM while they are blank.
KEYCLOAK_URL=
KEYCLOAK_REALM=

# -----------------------------------------------------------------------------
# MainNet (zkpc) — read ONLY by scripts run with `--network zkpc` (dars:upload default).
# A missing value fails fast instead of minting a token against the wrong Keycloak.
# -----------------------------------------------------------------------------
ZKPC_LEDGER_API_URL=https://api.validator.main.zkpc.cantor8.tech/api/ledger
ZKPC_KEYCLOAK_URL=https://auth.main.zkpc.cantor8.tech
ZKPC_KEYCLOAK_REALM=master
ZKPC_KEYCLOAK_CLIENT_ID=
ZKPC_KEYCLOAK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Enterprise Wallet (treasury / admin party) — see ../enterprise-wallet/README.md
# -----------------------------------------------------------------------------
# REST URL of the self-hosted Cantor8 Enterprise Wallet (local docker: http://localhost:8080).
VITE_ENTERPRISE_WALLET_URL=http://localhost:8080
# Admin party created with `npm run create:account` (signatory on MarketCounter / UserWallet).
VITE_ENTERPRISE_WALLET_PARTY_ID=
# `appName` sent to /api/v1/external/submit — must match the wallet's CLIENT_ID tenant.
VITE_ENTERPRISE_WALLET_APP_NAME=truthoracle
# Optional: a SEPARATE confidential client for the wallet's own Keycloak issuer. The wallet runs
# with `AUTH_TYPE=keycloak` and trusts the issuer of ITS deployment, which may differ from the
# ledger's; a 401 "Key ID … not found in JWKS" means the token came from the wrong one. Resolution order:
# WALLET_KEYCLOAK_* → KEYCLOAK_* → VITE_KEYCLOAK_* for URL and REALM; CLIENT_ID / CLIENT_SECRET fall
# back to KEYCLOAK_CLIENT_ID / KEYCLOAK_CLIENT_SECRET only, never to a VITE_ name. Blank = fall back.
WALLET_KEYCLOAK_URL=
WALLET_KEYCLOAK_REALM=
WALLET_KEYCLOAK_CLIENT_ID=
WALLET_KEYCLOAK_CLIENT_SECRET=
# Validator the admin party is created on (create:account): NAME is the node identity, for humans
# (e.g. zkpc-cantor8-1); ID is the wallet's numeric slot for it (SDK_VALIDATOR_<n>_NAME in the wallet
# deployment). ID has no default on purpose — slot 0 is the network's default validator, usually not
# the project's node — so create:account refuses to run until it is set here or passed as --validator-id.
WALLET_VALIDATOR_NAME=
WALLET_VALIDATOR_ID=
