# TruthOracle contracts — operator scripts configuration.
# Copy to `.env` and fill in the blanks. Every script loads `<repo>/.env` via dotenv and
# reads ONLY the names below (the VITE_ spellings are kept so a `.env` copied from the
# frontend keeps working). Nothing here is ever shipped to a browser.
#
# Which script reads what:
#   dars:upload        VITE_APP_NETWORK, ZKPC_* (default target) or VITE_CANTON_PARTICIPANT_URL + KEYCLOAK_*
#   ledger:query       same as dars:upload (+ --network devnet|zkpc)
#   contracts:active   same, plus VITE_TRUTHORACLE_PACKAGE_NAME, VITE_ENTERPRISE_WALLET_PARTY_ID (or --party)
#   rights:grant       same, plus VITE_ENTERPRISE_WALLET_PARTY_ID (or --party)
#   create:contract    VITE_ENTERPRISE_WALLET_URL, WALLET_KEYCLOAK_* → KEYCLOAK_* → VITE_KEYCLOAK_*,
#                      VITE_TRUTHORACLE_PACKAGE_ID, VITE_ENTERPRISE_WALLET_PARTY_ID, VITE_ENTERPRISE_WALLET_APP_NAME
#   create:account     VITE_ENTERPRISE_WALLET_URL, WALLET_KEYCLOAK_* → KEYCLOAK_* → VITE_KEYCLOAK_*,
#                      WALLET_VALIDATOR_NAME, WALLET_VALIDATOR_ID
#
# Credentials (CLIENT_ID / CLIENT_SECRET) are deliberately NOT read from any VITE_-prefixed
# name — see scripts/create-contract.ts.

# -----------------------------------------------------------------------------
# Network + package
# -----------------------------------------------------------------------------
# devnet | mainnet. Only "mainnet" is special-cased (ledger scripts then read ZKPC_* ONLY).
VITE_APP_NETWORK=devnet

# Package id of the DAR currently deployed (printed by `npm run dars:upload`), and the
# daml.yaml `name:`. Active-contracts filters must use the package NAME ("#name:Module:Entity").
VITE_TRUTHORACLE_PACKAGE_ID=59a785f1aa72f96da4a8569964eeca2efd333a53957075714ff0f57acc37499d
VITE_TRUTHORACLE_PACKAGE_NAME=truthoracle-v15

# -----------------------------------------------------------------------------
# DevNet (digik) — Canton JSON Ledger API + Keycloak
# -----------------------------------------------------------------------------
VITE_CANTON_PARTICIPANT_URL=https://api.validator.dev.digik.cantor8.tech/api/ledger
VITE_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
VITE_KEYCLOAK_REALM=master
# client_credentials pair for the DevNet Keycloak above (shared by Cantor8).
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
# Optional non-VITE aliases (create:contract / create:account prefer these when set).
# KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
# KEYCLOAK_REALM=master

# -----------------------------------------------------------------------------
# MainNet (zkpc) — read ONLY by scripts run with `--network zkpc` (dars:upload default).
# A missing value fails fast instead of minting a token against the wrong Keycloak.
# -----------------------------------------------------------------------------
ZKPC_LEDGER_API_URL=https://api.validator.main.zkpc.cantor8.tech/api/ledger
ZKPC_KEYCLOAK_URL=https://auth.main.zkpc.cantor8.tech
ZKPC_KEYCLOAK_REALM=master
ZKPC_KEYCLOAK_CLIENT_ID=
ZKPC_KEYCLOAK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Enterprise Wallet (treasury / admin party) — see ../enterprise-wallet/README.md
# -----------------------------------------------------------------------------
# REST URL of the self-hosted Cantor8 Enterprise Wallet (local docker: http://localhost:8080).
VITE_ENTERPRISE_WALLET_URL=http://localhost:8080
# Admin party created with `npm run create:account` (signatory on MarketCounter / UserWallet).
VITE_ENTERPRISE_WALLET_PARTY_ID=
# `appName` sent to /api/v1/external/submit — must match the wallet's CLIENT_ID tenant.
VITE_ENTERPRISE_WALLET_APP_NAME=truthoracle
# Optional: a SEPARATE confidential client for the wallet's own Keycloak issuer.
# URL/REALM fall back to KEYCLOAK_* / VITE_KEYCLOAK_*; CLIENT_ID/SECRET do not.
# WALLET_KEYCLOAK_URL=https://auth.dev.digik.cantor8.tech
# WALLET_KEYCLOAK_REALM=master
# WALLET_KEYCLOAK_CLIENT_ID=
# WALLET_KEYCLOAK_CLIENT_SECRET=
# Validator the admin party is created on (create:account): NAME is the node identity,
# ID the wallet's numeric slot for it (SDK_VALIDATOR_<n>_NAME in the wallet deployment).
# WALLET_VALIDATOR_NAME=zkpc-cantor8-1
# WALLET_VALIDATOR_ID=1
