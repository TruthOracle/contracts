-- Daml Script test suite for the TruthOracle dynamic pm-AMM, the tiered
-- resolution model (T0-T3), and the in-app UserWallet collateral rail. Every
-- market here is denominated in cBYN; TRO (the rewards token) exists to show
-- that a wallet in another instrument is refused wherever money moves.
module Test.Truthoracle where

import DA.Assert ((===))
import DA.Foldable (forA_)
import Daml.Script
import PmAmmMath
import Truthoracle

-- Times (epoch seconds) used across scenarios.
t0, tTrade, tExpiry, tAfterExpiry, tAfterGrace : Int
t0 = 1000000
tTrade = 1010000
tExpiry = 1086400            -- t0 + 1 day
tAfterExpiry = 1090000
tAfterGrace = 1200000        -- past expiry + 1 day grace

grace : Int
grace = 86_400

approxEq : Decimal -> Decimal -> Decimal -> Bool
approxEq tol a b = abs (a - b) <= tol

defaultPolicy : ResolutionPolicy
defaultPolicy = ResolutionPolicy with
  operatorResolution = True
  sources = ["https://example.com/result"]
  sourceKeys = []
  reporters = []
  quorum = 0
  challengeSecs = 0
  bond = 0.0

-- Parties and instruments shared by every scenario. cBYN's admin is the
-- transfer agent (Cantor8's registry party for the token); TRO's is its issuer.
data Env = Env with
  admin : Party        -- operator and treasury
  alice : Party
  bob : Party
  regulator : Party    -- audit observer; never a signatory or a controller
  cbyn : InstrumentId  -- the collateral of every market in this suite
  tro : InstrumentId   -- the rewards instrument; never a market collateral here

setup : Script Env
setup = do
  admin <- allocateParty "Admin"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  regulator <- allocateParty "Regulator"
  transferAgent <- allocateParty "CbynTransferAgent"
  troIssuer <- allocateParty "TroIssuer"
  return Env with
    admin, alice, bob, regulator
    cbyn = InstrumentId with admin = transferAgent; id = "cBYN"
    tro = InstrumentId with admin = troIssuer; id = "TRO"

createCounter : Party -> Script (ContractId MarketCounter)
createCounter admin =
  submit admin do
    createCmd MarketCounter with admin; value = 0

-- Create a user's in-app wallet for one instrument, visible to the given audit
-- observers, and credit an initial external deposit.
mkWalletObserved : Party -> InstrumentId -> [Party] -> Party -> Decimal -> Script (ContractId UserWallet)
mkWalletObserved admin instrument auditObservers owner amount = do
  wCid <- submit admin do
    createCmd UserWallet with
      admin, owner, instrument, auditObservers
      balance = 0.0
      deposited = 0.0
      withdrawn = 0.0
      creditRefs = []
  if amount > 0.0
    then submit admin do
      exerciseCmd wCid Deposit with amount, txRef = "0xdeposit"
    else return wCid

mkWallet : Party -> InstrumentId -> Party -> Decimal -> Script (ContractId UserWallet)
mkWallet admin instrument = mkWalletObserved admin instrument []

fetchWallet : Party -> ContractId UserWallet -> Script UserWallet
fetchWallet p cid = do
  wOpt <- queryContractId p cid
  case wOpt of
    None -> abort "expected wallet visible"
    Some w -> return w

walletBalance : Party -> ContractId UserWallet -> Script Decimal
walletBalance p cid = (.balance) <$> fetchWallet p cid

mkMarketObserved
  : Party -> InstrumentId -> [Party] -> ContractId MarketCounter -> ResolutionPolicy -> Bool -> Decimal -> Decimal
 -> Script (ContractId MarketCounter, ContractId PredictionMarket, ContractId LiquidityPosition)
mkMarketObserved admin collateral auditObservers counterCid policy isDynamic p0 v0 =
  submit admin do
    exerciseCmd counterCid CreateMarket with
      question = "Will Liverpool beat Brighton on 13 May 2026?"
      resolutionDescription = "Opta full-time scoreline"
      collateral
      createdAt = t0
      expiresAt = tExpiry
      gracePeriodSecs = grace
      isDynamic
      liquidityPeriodSecs = 0
      initialProbability = p0
      initialValue = v0
      feeBps = 30
      prizeFeeShareBps = 2000
      policy
      auditObservers
      ticker = "EPL-26MAY13-LIV"
      eventTicker = "EPL-26MAY13"
      yesSubTitle = "Liverpool win"
      noSubTitle = "Draw or Brighton"

mkMarket
  : Party -> InstrumentId -> ContractId MarketCounter -> ResolutionPolicy -> Bool -> Decimal -> Decimal
 -> Script (ContractId MarketCounter, ContractId PredictionMarket, ContractId LiquidityPosition)
mkMarket admin collateral = mkMarketObserved admin collateral []

fetchMarket : Party -> ContractId PredictionMarket -> Script PredictionMarket
fetchMarket p cid = do
  mOpt <- queryContractId p cid
  case mOpt of
    None -> abort "expected market visible"
    Some m -> return m

-- ---------------------------------------------------------------------------
-- pm-AMM math invariants (D-A2)
-- ---------------------------------------------------------------------------

pmAmmMathInvariants : Script ()
pmAmmMathInvariants = do
  -- Normal distribution sanity.
  assert (approxEq 0.0001 0.5 (normCdf 0.0))
  assert (approxEq 0.0005 0.8413447461 (normCdf 1.0))
  assert (approxEq 0.001 1.6448536270 (normInvCdf 0.95))
  assert (approxEq 0.0001 0.3989422804 (normPdf 0.0))
  -- Round trip: cdf(icdf(p)) == p across the simplex.
  let ps = [0.05, 0.2, 0.5, 0.7, 0.95]
  forA_ ps (\p -> assert (approxEq 0.001 p (normCdf (normInvCdf p))))
  -- Closed-form reserves satisfy the invariant and reproduce the price.
  forA_ ps (\p -> do
    let l = 100.0
        (x, y) = optimalReserves p l
    assert (approxEq 0.01 0.0 (invariantValue x y l))
    assert (approxEq 0.005 p (priceFromReserves x y l))
    -- Pool value closed form: V = L * pdf(icdf P).
    assert (approxEq 0.01 (poolValue p l) (l * normPdf (normInvCdf p))))
  -- Time decay: L_eff = L0 * sqrt((T-t)/(T-t0)); halfway -> sqrt(0.5).
  let lEffHalf = effectiveLiquidity True 100.0 0 100 50
  assert (approxEq 0.01 70.7106781 lEffHalf)
  effectiveLiquidity False 100.0 0 100 50 === 100.0
  -- Buy/sell round trip loses only rounding + spread, never mints value.
  let l = 100.0
      (x, y) = optimalReserves 0.5 l
      n = solveBuyShares x y l 10.0
  -- 10 units of collateral at ~0.5 must buy more than 10 but fewer than 20 YES.
  assert (n > 10.0 && n < 20.0)
  let c = solveSellProceeds (x + 10.0 - n) (y + 10.0) l n
  assert (c <= 10.0 + 0.01 && c > 8.0)

-- ---------------------------------------------------------------------------
-- In-app wallet: deposit / debit-auth / withdraw / cancel-refund (wallet rail)
-- ---------------------------------------------------------------------------

inAppWalletLifecycle : Script ()
inAppWalletLifecycle = do
  Env{admin, alice, bob, cbyn} <- setup
  aliceW <- mkWallet admin cbyn alice 50.0
  w0 <- fetchWallet alice aliceW
  w0.instrument === cbyn
  w0.balance === 50.0
  w0.deposited === 50.0
  w0.withdrawn === 0.0
  w0.creditRefs === ["0xdeposit"]

  -- Crediting the same external transfer twice is rejected on-ledger; a fresh
  -- txRef appends to the record. Exercised on bob's wallet so alice's flow below
  -- stays on known balances.
  bobW <- mkWallet admin cbyn bob 5.0
  submitMustFail admin do
    exerciseCmd bobW Deposit with amount = 1.0, txRef = "0xdeposit"
  bobW <- submit admin do
    exerciseCmd bobW Deposit with amount = 10.0, txRef = "0xdeposit2"
  wb <- fetchWallet bob bobW
  wb.balance === 15.0
  wb.deposited === 15.0
  wb.creditRefs === ["0xdeposit2", "0xdeposit"]

  -- Neither the owner nor the admin can debit unilaterally.
  submitMustFail alice do
    exerciseCmd aliceW Debit with amount = 5.0, reason = "steal"
  submitMustFail admin do
    exerciseCmd aliceW Debit with amount = 5.0, reason = "steal"
  -- A third party cannot withdraw from someone else's wallet.
  submitMustFail bob do
    exerciseCmd aliceW Withdraw with amount = 5.0, nowSeconds = t0
  -- Over-withdrawal is rejected.
  submitMustFail alice do
    exerciseCmd aliceW Withdraw with amount = 60.0, nowSeconds = t0

  -- Withdraw 20: balance debited, PendingPayout queued for the admin.
  (aliceW, payoutCid) <- submit alice do
    exerciseCmd aliceW Withdraw with amount = 20.0, nowSeconds = t0
  w1 <- fetchWallet alice aliceW
  w1.balance === 30.0
  w1.withdrawn === 20.0
  pOpt <- queryContractId alice payoutCid
  case pOpt of
    None -> abort "expected payout visible"
    Some p -> do
      p.reason === "withdraw"
      p.amount === 20.0
      p.instrument === cbyn
      p.marketId === 0

  -- Cancel with a refund target re-credits the in-app balance.
  refund <- submit alice do
    exerciseCmd payoutCid CancelPayout with refundWalletCid = Some aliceW
  aliceW <- case refund of
    None -> abort "expected refund credit"
    Some wCid -> return wCid
  bal <- walletBalance alice aliceW
  bal === 50.0

  -- Buys are capped by the in-app balance, and only the wallet's owner can
  -- spend it.
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 100.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  submitMustFail (actAs bob <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      amount = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW

-- ---------------------------------------------------------------------------
-- Lifecycle: create -> buy -> sell -> resolve (T0) -> redeem (D-A2, D-B1)
-- ---------------------------------------------------------------------------

lifecycleBuySellResolveRedeem : Script ()
lifecycleBuySellResolveRedeem = do
  Env{admin, alice, bob, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 100.0
  bobW <- mkWallet admin cbyn bob 50.0

  m0 <- fetchMarket admin marketCid
  m0.currentPrice === 0.5
  m0.status === Trading
  m0.collateral === cbyn
  assert (m0.liquidityL > 0.0)

  -- Alice buys YES with 10 cBYN debited from her in-app wallet.
  (marketCid, alicePosCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  aliceBal1 <- walletBalance alice aliceW
  aliceBal1 === 90.0

  m1 <- fetchMarket admin marketCid
  assert (m1.currentPrice > 0.5)  -- YES demand moves the price up
  assert (m1.currentPrice < 1.0)
  assert (m1.accumulatedFees > 0.0)
  assert (m1.prizePool > 0.0)
  m1.totalVolume === 10.0
  m1.collateral === cbyn            -- the successor version keeps the denomination

  Some alicePos <- queryContractId alice alicePosCid
  assert (alicePos.yesShares > 10.0)  -- bought below 1.0/share
  alicePos.costBasis === 10.0

  -- Bob buys NO, price comes back down.
  (marketCid, _, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = No
      amount = 5.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 100
      existingPosition = None
      walletCid = bobW
  bobBal1 <- walletBalance bob bobW
  bobBal1 === 45.0
  m2 <- fetchMarket admin marketCid
  assert (m2.currentPrice < m1.currentPrice)

  -- Alice sells half her YES back; net proceeds land in her wallet instantly.
  let sellShares = 5.0
  (marketCid, alicePosCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Sell with
      seller = alice
      side = Yes
      sharesIn = sellShares
      minProceeds = 0.5
      nowSeconds = tTrade + 200
      positionCid = alicePosCid
      walletCid = aliceW
  aliceBal2 <- walletBalance alice aliceW
  -- Proceeds are positive but below 1 unit per share.
  assert (aliceBal2 > 90.0 && aliceBal2 < 90.0 + sellShares)

  -- Too-early resolution is rejected.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tTrade
  -- Non-allowlisted source is rejected.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://evil.example.com"
      nowSeconds = tAfterExpiry

  -- T0 resolve to YES.
  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  m3 <- fetchMarket admin marketCid
  m3.status === Resolved
  m3.outcome === Some Yes

  -- Trading after resolution fails.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 1.0
      minSharesOut = 0.1
      nowSeconds = tAfterExpiry
      existingPosition = None
      walletCid = aliceW

  -- Alice redeems: 1 unit per remaining winning YES share, into her wallet.
  Some aliceFinal <- queryContractId alice alicePosCid
  aliceW <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterExpiry + 100
      positionCid = alicePosCid
      walletCid = aliceW
  aliceBal3 <- walletBalance alice aliceW
  aliceBal3 === aliceBal2 + aliceFinal.yesShares

-- ---------------------------------------------------------------------------
-- Direct outcome-token swap (YES <-> NO)
-- ---------------------------------------------------------------------------

swapSharesBetweenOutcomes : Script ()
swapSharesBetweenOutcomes = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 20.0

  -- Alice mints 10 complete sets, then swaps 5 NO -> YES.
  (posCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Split with
      user = alice
      amount = 10.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  bal <- walletBalance alice aliceW
  bal === 10.0
  m0 <- fetchMarket admin marketCid

  (marketCid, posCid) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid SwapShares with
      swapper = alice
      fromSide = No
      sharesIn = 5.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 10
      positionCid = posCid
  Some pos <- queryContractId alice posCid
  pos.noShares === 5.0
  -- Swapping NO in at ~50% yields roughly as many YES out (minus fee/impact).
  assert (pos.yesShares > 13.0 && pos.yesShares < 15.0)
  m1 <- fetchMarket admin marketCid
  -- Buying pressure on YES (NO in, YES out) moves the YES price up.
  assert (m1.currentPrice > m0.currentPrice)

  -- Cannot swap more than held.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid SwapShares with
      swapper = alice
      fromSide = No
      sharesIn = 50.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 20
      positionCid = posCid

-- ---------------------------------------------------------------------------
-- Pre-trading liquidity-collection window (dynamic pools)
-- ---------------------------------------------------------------------------

liquidityPeriodGatesTrading : Script ()
liquidityPeriodGatesTrading = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  aliceW <- mkWallet admin cbyn alice 100.0
  let periodSecs = 3600
  (_, marketCid, _) <- submit admin do
    exerciseCmd counterCid CreateMarket with
      question = "Liquidity-period market?"
      resolutionDescription = "operator"
      collateral = cbyn
      createdAt = t0
      expiresAt = tExpiry
      gracePeriodSecs = grace
      isDynamic = True
      liquidityPeriodSecs = periodSecs
      initialProbability = 0.5
      initialValue = 100.0
      feeBps = 30
      prizeFeeShareBps = 0
      policy = defaultPolicy
      auditObservers = []
      ticker = "EPL-26MAY13-PERIOD"
      eventTicker = "EPL-26MAY13"
      yesSubTitle = "Yes"
      noSubTitle = "No"

  let duringPeriod = t0 + 100
  -- Buys are blocked during the collection window...
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 5.0
      minSharesOut = 1.0
      nowSeconds = duringPeriod
      existingPosition = None
      walletCid = aliceW
  -- ...but minting complete sets and providing liquidity are allowed.
  (posCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Split with
      user = alice
      amount = 3.0
      nowSeconds = duringPeriod
      existingPosition = None
      walletCid = aliceW
  balAfterSplit <- walletBalance alice aliceW
  balAfterSplit === 97.0
  (marketCid, _, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncrease = 10.0
      maxCost = 50.0
      nowSeconds = duringPeriod
      existingLpPosition = None
      walletCid = aliceW
  balAfterLp <- walletBalance alice aliceW
  assert (balAfterLp < balAfterSplit)
  -- After the window, trading opens.
  (marketCid, _, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 5.0
      minSharesOut = 1.0
      nowSeconds = t0 + periodSecs + 10
      existingPosition = Some posCid
      walletCid = aliceW
  balAfterBuy <- walletBalance alice aliceW
  balAfterBuy === balAfterLp - 5.0
  m <- fetchMarket admin marketCid
  assert (m.currentPrice > 0.5)

-- ---------------------------------------------------------------------------
-- Split / Merge complete sets
-- ---------------------------------------------------------------------------

splitMergeCompleteSets : Script ()
splitMergeCompleteSets = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.4 50.0
  aliceW <- mkWallet admin cbyn alice 20.0

  (posCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Split with
      user = alice
      amount = 7.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  Some pos <- queryContractId alice posCid
  pos.yesShares === 7.0
  pos.noShares === 7.0
  pos.costBasis === 7.0
  bal1 <- walletBalance alice aliceW
  bal1 === 13.0

  (posCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 3.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceW
  Some pos2 <- queryContractId alice posCid
  pos2.yesShares === 4.0
  pos2.noShares === 4.0
  bal2 <- walletBalance alice aliceW
  bal2 === 16.0

  -- Over-merge fails.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 100.0
      nowSeconds = tTrade + 20
      positionCid = posCid
      walletCid = aliceW

-- ---------------------------------------------------------------------------
-- Value-based liquidity provision and withdrawal (D-A2)
-- ---------------------------------------------------------------------------

liquidityProvisionAndWithdrawal : Script ()
liquidityProvisionAndWithdrawal = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  -- Static pool so early withdrawal is allowed.
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 100.0
  m0 <- fetchMarket admin marketCid

  (marketCid, lpCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncrease = 25.0
      maxCost = 100.0
      nowSeconds = tTrade
      existingLpPosition = None
      walletCid = aliceW
  m1 <- fetchMarket admin marketCid
  -- Value-based deposit leaves the price unchanged and scales L by (V+dV)/V.
  m1.currentPrice === m0.currentPrice
  assert (approxEq 0.01 (m0.liquidityL * 1.25) m1.liquidityL)
  assert (m1.lpTokenSupply > m0.lpTokenSupply)
  Some lp <- queryContractId alice lpCid
  assert (lp.lpTokens > 0.0)
  bal1 <- walletBalance alice aliceW
  assert (bal1 < 100.0)  -- provision cost debited
  lp.deposited === 100.0 - bal1

  -- Early exit (static): shares + fee split, LP burned. No trades happened,
  -- so the fee credit is zero and the wallet cid passes through unchanged.
  (marketCid, _, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tTrade + 100
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  m2 <- fetchMarket admin marketCid
  assert (m2.lpTokenSupply < m1.lpTokenSupply)
  assert (m2.reserveYes < m1.reserveYes)
  bal2 <- walletBalance alice aliceW
  bal2 === bal1

dynamicLpLockedUntilResolution : Script ()
dynamicLpLockedUntilResolution = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 100.0
  (marketCid, lpCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncrease = 10.0
      maxCost = 50.0
      nowSeconds = tTrade
      existingLpPosition = None
      walletCid = aliceW
  bal1 <- walletBalance alice aliceW
  -- Locked while trading.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = 1.0
      nowSeconds = tTrade + 10
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  -- After resolution the LP exits with winning reserve + fee share, credited
  -- straight to the in-app wallet.
  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = No
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  Some lp <- queryContractId alice lpCid
  (_, _, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tAfterExpiry + 10
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceW
  bal2 <- walletBalance alice aliceW
  assert (bal2 > bal1)

-- ---------------------------------------------------------------------------
-- T2 reporter quorum (D-B3)
-- ---------------------------------------------------------------------------

reporterQuorumResolves : Script ()
reporterQuorumResolves = do
  Env{admin, cbyn} <- setup
  r1 <- allocateParty "Reporter1"
  r2 <- allocateParty "Reporter2"
  r3 <- allocateParty "Reporter3"
  let policy = defaultPolicy with
        operatorResolution = False
        reporters = [r1, r2, r3]
        quorum = 2
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid policy True 0.5 100.0
  m <- fetchMarket admin marketCid

  -- T0 is disabled under this policy.
  submitMustFail admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry

  let mkAtt reporter out = createCmd OutcomeAttestation with
        attester = reporter
        admin
        marketId = m.marketId
        sourceUri = "https://example.com/result"
        fetchedAt = tAfterExpiry
        outcome = out
        payloadHash = "deadbeef"
        sourceSignature = None
        responseExcerpt = Some "2-1"
  att1 <- submit r1 (mkAtt r1 Yes)
  att2 <- submit r2 (mkAtt r2 Yes)
  attBad <- submit r3 (mkAtt r3 No)

  -- Disagreeing attestations cannot resolve.
  submitMustFail admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, attBad]
      nowSeconds = tAfterExpiry + 10
  -- Sub-quorum cannot resolve.
  submitMustFail admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1]
      nowSeconds = tAfterExpiry + 10
  -- 2-of-3 agreeing attestations resolve.
  marketCid <- submit admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, att2]
      nowSeconds = tAfterExpiry + 10
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes

-- ---------------------------------------------------------------------------
-- T3 optimistic propose / challenge / finalize (D-B4)
-- ---------------------------------------------------------------------------

optimisticFinalizeUnchallenged : Script ()
optimisticFinalizeUnchallenged = do
  Env{admin, alice, bob, cbyn} <- setup
  let policy = defaultPolicy with
        operatorResolution = False
        challengeSecs = 3600
        bond = 10.0
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid policy True 0.5 100.0
  bobW <- mkWallet admin cbyn bob 20.0

  -- Propose before expiry fails.
  submitMustFail (actAs bob <> readAs admin) do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = Yes
      nowSeconds = tTrade
      walletCid = bobW
  -- Bob proposes YES; the bond is debited from his in-app wallet.
  (marketCid, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = bobW
  bondBal <- walletBalance bob bobW
  bondBal === 10.0
  m <- fetchMarket admin marketCid
  m.status === Proposed
  -- Finalize inside the window fails.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = alice
      nowSeconds = tAfterExpiry + 100
  -- After the window, anyone finalizes; the bond returns to the proposer as
  -- a PendingPayout in the market's collateral that the admin can settle into
  -- the in-app wallet.
  marketCid <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = alice
      nowSeconds = tAfterExpiry + 3700
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes
  payouts <- query @PendingPayout bob
  bondPayoutCid <- case [cid | (cid, p) <- payouts, p.reason == "bond", p.user == bob, p.amount == 10.0, p.instrument == cbyn] of
    (cid :: _) -> return cid
    [] -> abort "expected bond payout"
  bobW <- submit admin do
    exerciseCmd bondPayoutCid SettleToWallet with walletCid = bobW
  finalBal <- walletBalance bob bobW
  finalBal === 20.0

optimisticChallengeEscalatesToQuorum : Script ()
optimisticChallengeEscalatesToQuorum = do
  Env{admin, alice, bob, cbyn} <- setup
  r1 <- allocateParty "ReporterA"
  r2 <- allocateParty "ReporterB"
  let policy = defaultPolicy with
        operatorResolution = False
        reporters = [r1, r2]
        quorum = 2
        challengeSecs = 3600
        bond = 10.0
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid policy True 0.5 100.0
  bobW <- mkWallet admin cbyn bob 20.0
  aliceW <- mkWallet admin cbyn alice 20.0
  m <- fetchMarket admin marketCid

  -- Bob proposes NO (wrongly); Alice challenges with YES. Both bonds are
  -- debited from their in-app wallets.
  (marketCid, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = No
      nowSeconds = tAfterExpiry
      walletCid = bobW
  bobBal <- walletBalance bob bobW
  bobBal === 10.0
  (marketCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ChallengeOutcome with
      challenger = alice
      challengerOutcome = Yes
      nowSeconds = tAfterExpiry + 100
      walletCid = aliceW
  aliceBal <- walletBalance alice aliceW
  aliceBal === 10.0
  -- A challenged proposal cannot be finalized - it must escalate.
  submitMustFail (actAs bob <> readAs admin) do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = bob
      nowSeconds = tAfterExpiry + 3700
  -- Reporters attest YES; Resolve settles and slashes Bob's bond to Alice.
  let mkAtt reporter = createCmd OutcomeAttestation with
        attester = reporter
        admin
        marketId = m.marketId
        sourceUri = "https://example.com/result"
        fetchedAt = tAfterExpiry + 200
        outcome = Yes
        payloadHash = "deadbeef"
        sourceSignature = None
        responseExcerpt = None
  att1 <- submit r1 (mkAtt r1)
  att2 <- submit r2 (mkAtt r2)
  marketCid <- submit admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, att2]
      nowSeconds = tAfterExpiry + 300
  m2 <- fetchMarket admin marketCid
  m2.status === Resolved
  m2.outcome === Some Yes
  payouts <- query @PendingPayout alice
  winCid <- case [cid | (cid, p) <- payouts, p.reason == "bond", p.user == alice, p.amount == 20.0, p.instrument == cbyn] of
    (cid :: _) -> return cid
    [] -> abort "expected slashed-bond payout"
  aliceW <- submit admin do
    exerciseCmd winCid SettleToWallet with walletCid = aliceW
  aliceFinal <- walletBalance alice aliceW
  aliceFinal === 30.0

-- ---------------------------------------------------------------------------
-- Void path (expired without resolution) and void refunds (D-B1)
-- ---------------------------------------------------------------------------

voidRefundsCostBasis : Script ()
voidRefundsCostBasis = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 10.0
  (marketCid, posCid, aliceW) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 8.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  bal1 <- walletBalance alice aliceW
  bal1 === 2.0
  -- Void before grace elapses fails.
  submitMustFail admin do
    exerciseCmd marketCid VoidMarket with nowSeconds = tAfterExpiry
  marketCid <- submit admin do
    exerciseCmd marketCid VoidMarket with nowSeconds = tAfterGrace
  m <- fetchMarket admin marketCid
  m.status === Voided
  -- The void refund credits the cost basis back to the in-app wallet.
  aliceW <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterGrace + 10
      positionCid = posCid
      walletCid = aliceW
  bal2 <- walletBalance alice aliceW
  bal2 === 10.0

-- ---------------------------------------------------------------------------
-- Prediction-model marketplace: commit-before-outcome + Brier scoring (D-E1)
-- ---------------------------------------------------------------------------

forecastCommitAndScoring : Script ()
forecastCommitAndScoring = do
  Env{admin, alice, bob, cbyn} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy True 0.5 100.0
  bobW <- mkWallet admin cbyn bob 200.0

  -- Trade to fund the prize pool (20% of the 0.3% fee).
  (marketCid, _, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      amount = 100.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = bobW
  m <- fetchMarket admin marketCid
  assert (m.prizePool > 0.0)

  -- Alice's model is confident YES (beats the market price), Bob's says NO.
  fAlice <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid CommitForecast with
      author = alice
      modelId = "alice-model-1"
      probabilityYes = 0.9
      nowSeconds = tTrade + 10
  fBob <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid CommitForecast with
      author = bob
      modelId = "bob-model-1"
      probabilityYes = 0.1
      nowSeconds = tTrade + 10
  -- Forecasts cannot be committed after expiry (commit-before-outcome).
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid CommitForecast with
      author = alice
      modelId = "alice-model-1"
      probabilityYes = 0.99
      nowSeconds = tAfterExpiry

  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry
  marketCid <- submit admin do
    exerciseCmd marketCid ScoreAndDistribute with
      forecastCids = [fAlice, fBob]
      nowSeconds = tAfterExpiry + 10
  m2 <- fetchMarket admin marketCid
  m2.prizePool === 0.0
  -- Only Alice beat the market; she gets the whole pool, owed in the market's collateral.
  alicePrizes <- query @PendingPayout alice
  case [p | (_, p) <- alicePrizes, p.reason == "model-prize", p.user == alice] of
    [p] -> do
      p.instrument === cbyn
      p.amount === m.prizePool
    _ -> abort "expected exactly one model-prize payout for alice"
  bobPrizes <- query @PendingPayout bob
  assert (not (any (\(_, p) -> p.reason == "model-prize" && p.user == bob) bobPrizes))

-- ---------------------------------------------------------------------------
-- Catalog identity: two legs of one event carry distinct tickers and the shared
-- eventTicker; every field is mandatory and non-empty. The fields are inert for
-- trading and resolution - every choice carries them along unchanged.
-- ---------------------------------------------------------------------------

catalogIdentityOnMarkets : Script ()
catalogIdentityOnMarkets = do
  Env{admin, alice, cbyn} <- setup
  counterCid <- createCounter admin
  aliceW <- mkWallet admin cbyn alice 100.0
  (counterCid, cut25Cid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.5 100.0
  -- CreateMarket consumes the counter and returns the successor; keep threading it.
  (counterCid, holdCid, _) <- submit admin do
    exerciseCmd counterCid CreateMarket with
      question = "Will the Fed hold in March 2026?"
      resolutionDescription = "FOMC statement"
      collateral = cbyn
      createdAt = t0
      expiresAt = tExpiry
      gracePeriodSecs = grace
      isDynamic = False
      liquidityPeriodSecs = 0
      initialProbability = 0.4
      initialValue = 100.0
      feeBps = 30
      prizeFeeShareBps = 0
      policy = defaultPolicy
      auditObservers = []
      ticker = "EPL-26MAY13-HOLD"
      eventTicker = "EPL-26MAY13"
      yesSubTitle = "Hold"
      noSubTitle = "Cut or hike"
  m1 <- fetchMarket admin cut25Cid
  m2 <- fetchMarket admin holdCid
  m1.ticker === "EPL-26MAY13-LIV"
  m2.ticker === "EPL-26MAY13-HOLD"
  m1.eventTicker === "EPL-26MAY13"
  m2.eventTicker === m1.eventTicker
  m1.yesSubTitle === "Liverpool win"
  m2.yesSubTitle === "Hold"
  m2.noSubTitle === "Cut or hike"
  assert (m1.marketId /= m2.marketId)
  -- The identity survives a trade (the successor version is a copy of `this`).
  (cut25Cid, _, _) <- submit (actAs alice <> readAs admin) do
    exerciseCmd cut25Cid Buy with
      buyer = alice
      side = Yes
      amount = 5.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceW
  m1' <- fetchMarket admin cut25Cid
  m1'.ticker === "EPL-26MAY13-LIV"
  m1'.eventTicker === "EPL-26MAY13"
  m1'.noSubTitle === "Draw or Brighton"
  -- Blank identity is refused: a market without a ticker or an event cannot exist.
  let blank = \t e -> submitMustFail admin do
        exerciseCmd counterCid CreateMarket with
          question = "Blank identity?"
          resolutionDescription = "operator"
          collateral = cbyn
          createdAt = t0
          expiresAt = tExpiry
          gracePeriodSecs = grace
          isDynamic = False
          liquidityPeriodSecs = 0
          initialProbability = 0.5
          initialValue = 50.0
          feeBps = 30
          prizeFeeShareBps = 0
          policy = defaultPolicy
          auditObservers = []
          ticker = t
          eventTicker = e
          yesSubTitle = "Yes"
          noSubTitle = "No"
  blank "" "EPL-26MAY13"
  blank "EPL-26MAY13-BLANK" ""

-- ---------------------------------------------------------------------------
-- v17: one wallet per (owner, instrument). Money only ever moves through a
-- wallet that holds the instrument it is in - on the debit side (Buy, Split,
-- ProvideLiquidity, bonds) and on the credit side (Sell, Merge, Redeem,
-- WithdrawLiquidity, payout settlement).
-- ---------------------------------------------------------------------------

walletInstrumentMustMatchCollateral : Script ()
walletInstrumentMustMatchCollateral = do
  Env{admin, alice, cbyn, tro} <- setup
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.5 100.0
  aliceTro <- mkWallet admin tro alice 100.0
  aliceCbyn <- mkWallet admin cbyn alice 100.0

  -- A TRO wallet cannot pay for a cBYN market: not as a trader...
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceTro
  -- ...not as a liquidity provider...
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncrease = 10.0
      maxCost = 50.0
      nowSeconds = tTrade
      existingLpPosition = None
      walletCid = aliceTro
  -- ...and not when minting complete sets.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Split with
      user = alice
      amount = 5.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceTro
  -- The same trade through the cBYN wallet goes through and leaves TRO untouched.
  (marketCid, posCid, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceCbyn
  cbynBal <- walletBalance alice aliceCbyn
  cbynBal === 90.0
  troBal <- walletBalance alice aliceTro
  troBal === 100.0
  -- Credits are checked too: proceeds cannot land in a wallet of another instrument.
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Sell with
      seller = alice
      side = Yes
      sharesIn = 1.0
      minProceeds = 0.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceTro
  (_, _, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Sell with
      seller = alice
      side = Yes
      sharesIn = 1.0
      minProceeds = 0.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceCbyn
  cbynBal2 <- walletBalance alice aliceCbyn
  assert (cbynBal2 > 90.0)
  troBal2 <- walletBalance alice aliceTro
  troBal2 === 100.0

-- The instrument check guards every remaining money move as well: the credits
-- of Merge, RedeemPosition and WithdrawLiquidity, and the bond debits of
-- ProposeOutcome and ChallengeOutcome. Each refusal is followed by the same
-- move through the cBYN wallet, so only the instrument was wrong.
walletInstrumentCheckedOnEveryMove : Script ()
walletInstrumentCheckedOnEveryMove = do
  Env{admin, alice, bob, cbyn, tro} <- setup
  counterCid <- createCounter admin
  (counterCid, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.5 100.0
  aliceCbyn <- mkWallet admin cbyn alice 100.0
  aliceTro <- mkWallet admin tro alice 100.0
  bobCbyn <- mkWallet admin cbyn bob 100.0
  bobTro <- mkWallet admin tro bob 100.0

  -- Merge: complete sets cannot be burned into a TRO wallet.
  (posCid, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Split with
      user = alice
      amount = 10.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceCbyn
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 4.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceTro
  (posCid, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Merge with
      user = alice
      amount = 4.0
      nowSeconds = tTrade + 10
      positionCid = posCid
      walletCid = aliceCbyn
  balAfterMerge <- walletBalance alice aliceCbyn
  balAfterMerge === 94.0

  -- Alice provides liquidity and bob trades, so the pool holds fees and a
  -- winning reserve for the LP to collect after resolution.
  (marketCid, lpCid, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProvideLiquidity with
      provider = alice
      valueIncrease = 20.0
      maxCost = 50.0
      nowSeconds = tTrade + 20
      existingLpPosition = None
      walletCid = aliceCbyn
  (marketCid, _, bobCbyn) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      amount = 20.0
      minSharesOut = 1.0
      nowSeconds = tTrade + 30
      existingPosition = None
      walletCid = bobCbyn
  marketCid <- submit admin do
    exerciseCmd marketCid ResolveT0 with
      resolvedOutcome = Yes
      sourceUri = "https://example.com/result"
      nowSeconds = tAfterExpiry

  -- RedeemPosition: winnings cannot land in a TRO wallet.
  balBeforeRedeem <- walletBalance alice aliceCbyn
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterExpiry + 10
      positionCid = posCid
      walletCid = aliceTro
  aliceCbyn <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid RedeemPosition with
      holder = alice
      nowSeconds = tAfterExpiry + 10
      positionCid = posCid
      walletCid = aliceCbyn
  balAfterRedeem <- walletBalance alice aliceCbyn
  balAfterRedeem === balBeforeRedeem + 6.0   -- 6 YES left after the merge, 1 unit each

  -- WithdrawLiquidity: the LP's share of the winning reserve and the fees
  -- cannot land in a TRO wallet either.
  Some lp <- queryContractId alice lpCid
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tAfterExpiry + 20
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceTro
  (_, _, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid WithdrawLiquidity with
      provider = alice
      lpTokensToBurn = lp.lpTokens
      nowSeconds = tAfterExpiry + 20
      lpPositionCid = lpCid
      existingPosition = None
      walletCid = aliceCbyn
  balAfterLp <- walletBalance alice aliceCbyn
  assert (balAfterLp > balAfterRedeem)

  -- T3 bonds: neither the proposer's nor the challenger's bond can be paid
  -- from a TRO wallet.
  let policy = defaultPolicy with
        operatorResolution = False
        challengeSecs = 3600
        bond = 10.0
  (_, t3Cid, _) <- mkMarket admin cbyn counterCid policy True 0.5 100.0
  submitMustFail (actAs alice <> readAs admin) do
    exerciseCmd t3Cid ProposeOutcome with
      proposer = alice
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = aliceTro
  (t3Cid, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd t3Cid ProposeOutcome with
      proposer = alice
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = aliceCbyn
  balAfterBond <- walletBalance alice aliceCbyn
  balAfterBond === balAfterLp - 10.0
  submitMustFail (actAs bob <> readAs admin) do
    exerciseCmd t3Cid ChallengeOutcome with
      challenger = bob
      challengerOutcome = No
      nowSeconds = tAfterExpiry + 100
      walletCid = bobTro
  (_, bobCbyn) <- submit (actAs bob <> readAs admin) do
    exerciseCmd t3Cid ChallengeOutcome with
      challenger = bob
      challengerOutcome = No
      nowSeconds = tAfterExpiry + 100
      walletCid = bobCbyn
  bobBal <- walletBalance bob bobCbyn
  bobBal === 70.0   -- 100 - 20 (buy) - 10 (bond)

  -- Neither TRO balance moved through any of it.
  aliceTroBal <- walletBalance alice aliceTro
  aliceTroBal === 100.0
  bobTroBal <- walletBalance bob bobTro
  bobTroBal === 100.0

twoInstrumentWalletsCoexist : Script ()
twoInstrumentWalletsCoexist = do
  Env{admin, alice, cbyn, tro} <- setup
  aliceCbyn <- mkWallet admin cbyn alice 50.0
  aliceTro <- mkWallet admin tro alice 20.0
  -- Alice sees two wallets, one per instrument, each keeping its own books.
  wallets <- query @UserWallet alice
  length wallets === 2
  let ofInstrument i = [w | (_, w) <- wallets, w.instrument == i]
  case (ofInstrument cbyn, ofInstrument tro) of
    ([c], [t]) -> do
      c.balance === 50.0
      c.deposited === 50.0
      t.balance === 20.0
      t.deposited === 20.0
    _ -> abort "expected exactly one wallet per instrument"
  -- A cBYN market debits only the cBYN wallet...
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarket admin cbyn counterCid defaultPolicy False 0.5 100.0
  (_, _, aliceCbyn) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = alice
      side = Yes
      amount = 10.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = aliceCbyn
  cbynBal <- walletBalance alice aliceCbyn
  cbynBal === 40.0
  troBal <- walletBalance alice aliceTro
  troBal === 20.0
  -- ...and a TRO grant credits only the TRO wallet.
  aliceTro <- submit admin do
    exerciseCmd aliceTro Grant with amount = 5.0, ref = "reward:1", reason = "first_deposit_bonus"
  troBal2 <- walletBalance alice aliceTro
  troBal2 === 25.0
  cbynBal2 <- walletBalance alice aliceCbyn
  cbynBal2 === 40.0

grantIsIdempotent : Script ()
grantIsIdempotent = do
  Env{admin, alice, tro} <- setup
  aliceTro <- mkWallet admin tro alice 0.0
  -- A reward lands as a Grant: balance up, `deposited` untouched (nothing came
  -- in from outside), the ref recorded.
  aliceTro <- submit admin do
    exerciseCmd aliceTro Grant with amount = 5.0, ref = "reward:g1", reason = "trade_volume_rebate"
  w1 <- fetchWallet alice aliceTro
  w1.balance === 5.0
  w1.deposited === 0.0
  w1.creditRefs === ["reward:g1"]
  -- Replaying the same ref aborts on-ledger, whatever the amount or reason.
  submitMustFail admin do
    exerciseCmd aliceTro Grant with amount = 5.0, ref = "reward:g1", reason = "trade_volume_rebate"
  submitMustFail admin do
    exerciseCmd aliceTro Grant with amount = 1.0, ref = "reward:g1", reason = "manual"
  -- Deposits and grants share one ref namespace.
  submitMustFail admin do
    exerciseCmd aliceTro Deposit with amount = 1.0, txRef = "reward:g1"
  -- Only the admin grants, and only a positive amount.
  submitMustFail alice do
    exerciseCmd aliceTro Grant with amount = 5.0, ref = "reward:g2", reason = "self-service"
  submitMustFail admin do
    exerciseCmd aliceTro Grant with amount = 0.0, ref = "reward:g2", reason = "manual"
  -- A fresh ref applies; refs are kept newest first.
  aliceTro <- submit admin do
    exerciseCmd aliceTro Grant with amount = 7.0, ref = "reward:g2", reason = "manual"
  w2 <- fetchWallet alice aliceTro
  w2.balance === 12.0
  w2.deposited === 0.0
  w2.creditRefs === ["reward:g2", "reward:g1"]
  -- The namespace is shared in the other direction too: a deposit's txRef can
  -- never be reused by a grant, and only the deposit counts as deposited.
  aliceTro <- submit admin do
    exerciseCmd aliceTro Deposit with amount = 1.0, txRef = "0xtro-deposit"
  submitMustFail admin do
    exerciseCmd aliceTro Grant with amount = 1.0, ref = "0xtro-deposit", reason = "manual"
  w3 <- fetchWallet alice aliceTro
  w3.balance === 13.0
  w3.deposited === 1.0
  w3.creditRefs === ["0xtro-deposit", "reward:g2", "reward:g1"]
  -- Granted TRO is withdrawable like any other balance.
  (aliceTro, payoutCid) <- submit alice do
    exerciseCmd aliceTro Withdraw with amount = 13.0, nowSeconds = t0
  bal <- walletBalance alice aliceTro
  bal === 0.0
  Some payout <- queryContractId alice payoutCid
  payout.instrument === tro
  payout.amount === 13.0

withdrawCarriesInstrument : Script ()
withdrawCarriesInstrument = do
  Env{admin, alice, cbyn, tro} <- setup
  aliceCbyn <- mkWallet admin cbyn alice 50.0
  aliceTro <- mkWallet admin tro alice 20.0
  -- A withdrawal queues a payout in the wallet's instrument...
  (aliceTro, troPayoutCid) <- submit alice do
    exerciseCmd aliceTro Withdraw with amount = 8.0, nowSeconds = t0
  Some troPayout <- queryContractId alice troPayoutCid
  troPayout.instrument === tro
  troPayout.amount === 8.0
  troPayout.reason === "withdraw"
  troPayout.marketId === 0
  w <- fetchWallet alice aliceTro
  w.balance === 12.0
  w.withdrawn === 8.0
  -- ...and from the other wallet, in the other instrument.
  (aliceCbyn, cbynPayoutCid) <- submit alice do
    exerciseCmd aliceCbyn Withdraw with amount = 5.0, nowSeconds = t0
  Some cbynPayout <- queryContractId alice cbynPayoutCid
  cbynPayout.instrument === cbyn
  cbynPayout.amount === 5.0
  -- Settling a payout into a wallet checks the instrument on the admin's path
  -- (SettleToWallet) and on the user's (CancelPayout with a refund target).
  submitMustFail admin do
    exerciseCmd troPayoutCid SettleToWallet with walletCid = aliceCbyn
  submitMustFail alice do
    exerciseCmd troPayoutCid CancelPayout with refundWalletCid = Some aliceCbyn
  refund <- submit alice do
    exerciseCmd troPayoutCid CancelPayout with refundWalletCid = Some aliceTro
  aliceTro <- case refund of
    None -> abort "expected refund credit"
    Some wCid -> return wCid
  troBal <- walletBalance alice aliceTro
  troBal === 20.0
  aliceCbyn <- submit admin do
    exerciseCmd cbynPayoutCid SettleToWallet with walletCid = aliceCbyn
  cbynBal <- walletBalance alice aliceCbyn
  cbynBal === 50.0

regulatorSeesWalletAndPayout : Script ()
regulatorSeesWalletAndPayout = do
  Env{admin, alice, bob, regulator, cbyn} <- setup
  -- A wallet created with the regulator as audit observer is visible to it...
  aliceW <- mkWalletObserved admin cbyn [regulator] alice 50.0
  Some w <- queryContractId regulator aliceW
  w.auditObservers === [regulator]
  w.balance === 50.0
  -- ...but not to an unrelated party, and observing confers no authority.
  bobView <- queryContractId bob aliceW
  bobView === None
  submitMustFail regulator do
    exerciseCmd aliceW Withdraw with amount = 1.0, nowSeconds = t0
  -- A withdrawal's payout inherits the wallet's audit observers.
  (aliceW, payoutCid) <- submit alice do
    exerciseCmd aliceW Withdraw with amount = 10.0, nowSeconds = t0
  Some payout <- queryContractId regulator payoutCid
  payout.auditObservers === [regulator]
  payout.instrument === cbyn
  payout.amount === 10.0
  -- A payout the market creates (a T3 bond refund) carries the market's audit
  -- observers and its collateral.
  let policy = defaultPolicy with
        operatorResolution = False
        challengeSecs = 3600
        bond = 10.0
  counterCid <- createCounter admin
  (_, marketCid, _) <- mkMarketObserved admin cbyn [regulator] counterCid policy True 0.5 100.0
  (marketCid, _) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ProposeOutcome with
      proposer = alice
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = aliceW
  _ <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid FinalizeOutcome with
      finalizer = bob
      nowSeconds = tAfterExpiry + 3700
  regulatorPayouts <- query @PendingPayout regulator
  case [p | (_, p) <- regulatorPayouts, p.reason == "bond"] of
    [p] -> do
      p.user === alice
      p.amount === 10.0
      p.instrument === cbyn
      p.auditObservers === [regulator]
    _ -> abort "expected the regulator to see exactly one bond payout"

-- Every payout a market queues - a slashed bond settled by Resolve, a bond
-- refunded by VoidMarket, a model prize from ScoreAndDistribute - is owed in the
-- market's collateral and visible to the market's audit observers, and to nobody
-- else. (FinalizeOutcome's bond refund is covered in regulatorSeesWalletAndPayout.)
marketPayoutsCarryCollateralAndObservers : Script ()
marketPayoutsCarryCollateralAndObservers = do
  Env{admin, alice, bob, regulator, cbyn} <- setup
  stranger <- allocateParty "Stranger"
  r1 <- allocateParty "ReporterA"
  r2 <- allocateParty "ReporterB"
  let policy = defaultPolicy with
        operatorResolution = False
        reporters = [r1, r2]
        quorum = 2
        challengeSecs = 3600
        bond = 10.0
  counterCid <- createCounter admin
  (counterCid, marketCid, _) <- mkMarketObserved admin cbyn [regulator] counterCid policy True 0.5 100.0
  aliceW <- mkWallet admin cbyn alice 50.0
  bobW <- mkWallet admin cbyn bob 50.0
  m <- fetchMarket admin marketCid

  -- Bob's trade funds the prize pool; alice's forecast beats the market.
  (marketCid, _, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid Buy with
      buyer = bob
      side = Yes
      amount = 20.0
      minSharesOut = 1.0
      nowSeconds = tTrade
      existingPosition = None
      walletCid = bobW
  fAlice <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid CommitForecast with
      author = alice
      modelId = "alice-model-1"
      probabilityYes = 0.9
      nowSeconds = tTrade + 10
  mTraded <- fetchMarket admin marketCid
  assert (mTraded.prizePool > 0.0)

  -- Bob proposes No, alice challenges Yes and the reporters side with alice:
  -- Resolve slashes bob's bond to alice...
  (marketCid, bobW) <- submit (actAs bob <> readAs admin) do
    exerciseCmd marketCid ProposeOutcome with
      proposer = bob
      proposedOutcome = No
      nowSeconds = tAfterExpiry
      walletCid = bobW
  (marketCid, _) <- submit (actAs alice <> readAs admin) do
    exerciseCmd marketCid ChallengeOutcome with
      challenger = alice
      challengerOutcome = Yes
      nowSeconds = tAfterExpiry + 100
      walletCid = aliceW
  let mkAtt reporter = createCmd OutcomeAttestation with
        attester = reporter
        admin
        marketId = m.marketId
        sourceUri = "https://example.com/result"
        fetchedAt = tAfterExpiry + 200
        outcome = Yes
        payloadHash = "deadbeef"
        sourceSignature = None
        responseExcerpt = None
  att1 <- submit r1 (mkAtt r1)
  att2 <- submit r2 (mkAtt r2)
  marketCid <- submit admin do
    exerciseCmd marketCid Resolve with
      attestationCids = [att1, att2]
      nowSeconds = tAfterExpiry + 300
  -- ...and ScoreAndDistribute owes alice the prize pool.
  _ <- submit admin do
    exerciseCmd marketCid ScoreAndDistribute with
      forecastCids = [fAlice]
      nowSeconds = tAfterExpiry + 400

  -- A second market: an unchallenged proposal superseded by VoidMarket refunds
  -- the proposer's bond through the same settlement.
  (_, voidCid, _) <- mkMarketObserved admin cbyn [regulator] counterCid policy True 0.5 100.0
  (voidCid, _) <- submit (actAs bob <> readAs admin) do
    exerciseCmd voidCid ProposeOutcome with
      proposer = bob
      proposedOutcome = Yes
      nowSeconds = tAfterExpiry
      walletCid = bobW
  mVoid <- fetchMarket admin voidCid
  _ <- submit admin do
    exerciseCmd voidCid VoidMarket with nowSeconds = tAfterGrace

  -- The regulator sees all three payouts, each in the collateral and carrying
  -- the market's observers; a stranger sees none.
  payouts <- query @PendingPayout regulator
  length payouts === 3
  forA_ payouts (\(_, p) -> do
    p.instrument === cbyn
    p.auditObservers === [regulator])
  let owed reason user marketId =
        [p.amount | (_, p) <- payouts, p.reason == reason, p.user == user, p.marketId == marketId]
  owed "bond" alice m.marketId === [20.0]
  owed "model-prize" alice m.marketId === [mTraded.prizePool]
  owed "bond" bob mVoid.marketId === [10.0]
  owed "bond" bob m.marketId === []
  strangerView <- query @PendingPayout stranger
  length strangerView === 0
